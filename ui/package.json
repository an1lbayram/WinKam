{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "electron:only": "python -m pip install -e .. && cross-env PYTHONIOENCODING=utf-8 electron .",
    "electron:only:debug": "python -m pip install -e .. && cross-env WINKAM_DEVTOOLS=1 PYTHONIOENCODING=utf-8 electron .",
    "electron:dev": "python -m pip install -e .. && concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite --port 5173 --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 PYTHONIOENCODING=utf-8 electron .\"",
    "build": "vite build",
    "electron:build": "vite build",
    "sync-vendor": "node scripts/sync-vendor.mjs",
    "predist:win": "npm run sync-vendor",
    "dist:win": "node scripts/generate-icon.mjs && npm run build && electron-builder --win --x64",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.winkam.app",
    "productName": "WinKam",
    "icon": "build/icon.png",
    "beforePack": "electron/beforePack.cjs",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../config",
        "to": "config"
      },
      {
        "from": "vendor/python",
        "to": "python"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "is-elevated": "^4.0.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "extract-zip": "^2.0.1",
    "globals": "^17.4.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.9",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.4",
    "wait-on": "^9.0.4"
  }
}
